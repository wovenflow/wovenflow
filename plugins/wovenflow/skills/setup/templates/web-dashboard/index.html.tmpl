<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{PROJECT_NAME}} — dashboard</title>
{{IF UMBRELLA_PATH}}<link rel="stylesheet" href="/static/site.css">
<script defer src="/static/header.js"></script>{{ENDIF}}
<style>
  /* Local styles. When the umbrella site.css is present these are layered on
     top; when standalone they are the entire stylesheet. */
  :root {
    --bg: #0d1117;
    --panel: #161b22;
    --panel2: #1c2128;
    --border: #30363d;
    --text: #c9d1d9;
    --muted: #8b949e;
    --accent: #58a6ff;
    --ok: #3fb950;
    --warn: #d29922;
    --bad: #f85149;
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; padding: 0; }
  main { max-width: 1100px; margin: 0 auto; padding: 1rem 1.5rem 3rem; }
  .top-bar { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--border); padding-bottom: .5rem; margin-bottom: 1rem; }
  h1 { margin: 0; font-size: 1.3rem; color: var(--text); }
  .meta { color: var(--muted); font-family: var(--mono); font-size: .8rem; }
  .panel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem; }
  .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: .8rem 1rem; }
  .panel h2 { margin: 0 0 .5rem; font-size: .85rem; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; border-bottom: 1px solid var(--border); padding-bottom: .3rem; font-weight: 600; }
  .panel.wide { grid-column: 1 / -1; }
  .kv { display: grid; grid-template-columns: max-content 1fr; gap: .15rem .8rem; font-family: var(--mono); font-size: .82rem; }
  .kv .k { color: var(--muted); }
  .kv .v { color: var(--text); }
  .ok   { color: var(--ok); }
  .warn { color: var(--warn); }
  .bad  { color: var(--bad); }
  .muted { color: var(--muted); }
  .empty { color: var(--muted); font-style: italic; padding: .4rem 0; }
  pre.tail { background: var(--panel2); border: 1px solid var(--border); border-radius: 4px; padding: .5rem; font-size: .75rem; color: var(--text); max-height: 220px; overflow: auto; white-space: pre; margin-top: .5rem; }
  table.compact { border-collapse: collapse; font-size: .8rem; width: 100%; margin-top: .3rem; }
  table.compact th, table.compact td { padding: .25rem .5rem; border: 1px solid var(--border); text-align: left; vertical-align: top; }
  table.compact th { background: var(--panel2); color: var(--muted); font-weight: 600; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; }
  .pill { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: .65rem; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
  .pill-designed { background: #21262d; color: var(--accent); }
  .pill-tested   { background: #1f3027; color: var(--ok); }
  .pill-built    { background: #322212; color: var(--warn); }
  .live-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--ok); margin-right: 4px; vertical-align: middle; }
  .live-dot.stale { background: var(--warn); }
  .live-dot.dead  { background: var(--bad); }
  svg.chart { background: var(--panel2); border: 1px solid var(--border); border-radius: 4px; display: block; max-width: 100%; }
  .stat-big { font-size: 1.6rem; font-weight: 700; font-family: var(--mono); }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(80px, 1fr)); gap: .6rem; margin-top: .3rem; }
  .stat-cell .label { color: var(--muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; }
</style>
</head>
<body>
<main>
<div class="top-bar">
  <h1>{{PROJECT_NAME}}</h1>
  <div class="meta"><span class="live-dot" id="live-dot"></span><span id="generated-at">loading…</span> · <button id="refresh-now" type="button">refresh</button></div>
</div>
<div class="panel-grid" id="grid"><div class="empty">loading…</div></div>
</main>

<script>
const REFRESH_MS = {{INTERVAL_S}}000;
const STALE_AFTER_MS = REFRESH_MS * 4;
let lastFetchOk = null;
let timer = null;

const escapeHtml = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function panelWrap(title, body, wide = false) {
  return `<section class="panel ${wide ? 'wide' : ''}"><h2>${escapeHtml(title)}</h2>${body}</section>`;
}

function errorBody(p) {
  if (!p) return '<div class="empty">no data</div>';
  if (p.error) return `<div class="bad">${escapeHtml(p.error)}</div>`;
  return null;
}

// --- SVG helpers --- (inspired by /home/will/web/tekton/index.html)
function lineChartSvg(points, opts = {}) {
  const { w = 480, h = 130, color = '#58a6ff', yFmt = (v) => String(v) } = opts;
  if (!points || points.length === 0) return '<svg class="chart" width="' + w + '" height="' + h + '"><text x="10" y="20" font-size="11" fill="#8b949e">no data</text></svg>';
  const PAD_L = 36, PAD_R = 8, PAD_T = 10, PAD_B = 18;
  const xs = points.map((_, i) => i);
  const ys = points.map((p) => p.y ?? p);
  const yLo = Math.min(...ys);
  const yHi = Math.max(...ys);
  const yRange = (yHi - yLo) || 1;
  const xRange = (xs[xs.length - 1] - xs[0]) || 1;
  const sx = (i) => PAD_L + (i / xRange) * (w - PAD_L - PAD_R);
  const sy = (y) => PAD_T + (1 - (y - yLo) / yRange) * (h - PAD_T - PAD_B);
  const poly = points.map((p, i) => `${sx(i).toFixed(1)},${sy(p.y ?? p).toFixed(1)}`).join(' ');
  const yTicks = [yLo, (yLo + yHi) / 2, yHi];
  const yAxis = yTicks.map((y) => {
    const yp = sy(y);
    return `<line x1="${PAD_L}" y1="${yp.toFixed(1)}" x2="${w - PAD_R}" y2="${yp.toFixed(1)}" stroke="#30363d" stroke-width="0.5" stroke-dasharray="2,3"/><text x="${PAD_L - 4}" y="${(yp + 3).toFixed(1)}" font-size="9" fill="#8b949e" text-anchor="end">${escapeHtml(yFmt(y))}</text>`;
  }).join('');
  // x-axis: first / mid / last labels (use point.x if set)
  const labelAt = (i) => {
    const p = points[i];
    return p && p.x != null ? String(p.x) : String(i);
  };
  const xLabels = [0, Math.floor(points.length / 2), points.length - 1];
  const xAxis = xLabels.map((i) => `<text x="${sx(i).toFixed(1)}" y="${h - 4}" font-size="9" fill="#8b949e" text-anchor="middle">${escapeHtml(labelAt(i))}</text>`).join('');
  return `<svg class="chart" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" style="width:100%;max-width:${w}px;">${yAxis}${xAxis}<polyline fill="none" stroke="${color}" stroke-width="1.5" points="${poly}"/></svg>`;
}

function barChartSvg(bars, opts = {}) {
  const { w = 480, h = 160, color = '#58a6ff' } = opts;
  if (!bars || bars.length === 0) return '<svg class="chart" width="' + w + '" height="' + h + '"><text x="10" y="20" font-size="11" fill="#8b949e">no data</text></svg>';
  const PAD_L = 40, PAD_R = 8, PAD_T = 10, PAD_B = 28;
  const yHi = Math.max(...bars.map((b) => b.y), 0);
  const yRange = yHi || 1;
  const innerW = w - PAD_L - PAD_R;
  const barW = innerW / bars.length;
  const sy = (y) => PAD_T + (1 - y / yRange) * (h - PAD_T - PAD_B);
  const yTicks = [0, yHi / 2, yHi];
  const yAxis = yTicks.map((y) => {
    const yp = sy(y);
    return `<line x1="${PAD_L}" y1="${yp.toFixed(1)}" x2="${w - PAD_R}" y2="${yp.toFixed(1)}" stroke="#30363d" stroke-width="0.5" stroke-dasharray="2,3"/><text x="${PAD_L - 4}" y="${(yp + 3).toFixed(1)}" font-size="9" fill="#8b949e" text-anchor="end">${escapeHtml(String(Math.round(y * 100) / 100))}</text>`;
  }).join('');
  const rects = bars.map((b, i) => {
    const x = PAD_L + i * barW + 1;
    const y = sy(b.y);
    const bh = (h - PAD_T - PAD_B) - (y - PAD_T);
    return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${(barW - 2).toFixed(1)}" height="${bh.toFixed(1)}" fill="${color}"/>`;
  }).join('');
  const labels = bars.map((b, i) => {
    const x = PAD_L + i * barW + barW / 2;
    return `<text x="${x.toFixed(1)}" y="${h - 14}" font-size="9" fill="#8b949e" text-anchor="middle" transform="rotate(-30, ${x.toFixed(1)}, ${h - 14})">${escapeHtml(String(b.x).slice(0, 14))}</text>`;
  }).join('');
  return `<svg class="chart" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" style="width:100%;max-width:${w}px;">${yAxis}${rects}${labels}</svg>`;
}

function sparklineSvg(values, opts = {}) {
  const { w = 120, h = 24, color = '#58a6ff' } = opts;
  if (!values || values.length === 0) return '';
  const yLo = Math.min(...values);
  const yHi = Math.max(...values);
  const yRange = (yHi - yLo) || 1;
  const sx = (i) => (i / Math.max(1, values.length - 1)) * (w - 2) + 1;
  const sy = (v) => (1 - (v - yLo) / yRange) * (h - 2) + 1;
  const poly = values.map((v, i) => `${sx(i).toFixed(1)},${sy(v).toFixed(1)}`).join(' ');
  return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" style="vertical-align:middle"><polyline fill="none" stroke="${color}" stroke-width="1.2" points="${poly}"/></svg>`;
}
{{IF PANEL_TESTS}}

function renderTestsPanel(p) {
  const err = errorBody(p); if (err === null) {} else if (err) return panelWrap('Tests', err); else return '';
  if (!p) return panelWrap('Tests', '<div class="empty">no data</div>');
  const cls = p.ok ? 'ok' : 'bad';
  const stat = (p.pass != null && p.total != null) ? `${p.pass}/${p.total}` : (p.ok ? 'pass' : 'fail');
  return panelWrap('Tests', `
    <div class="kv">
      <div class="k">cmd</div><div class="v">${escapeHtml(p.cmd)}</div>
      <div class="k">result</div><div class="v ${cls}">${escapeHtml(stat)} (exit ${p.exit_code})</div>
      <div class="k">when</div><div class="v muted">${escapeHtml(p.finished_at || '')}</div>
    </div>
    <pre class="tail">${escapeHtml(p.output_tail || '')}</pre>
  `);
}
{{ENDIF}}
{{IF PANEL_SPECS}}

function renderSpecsPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Specs', err);
  if (!p || !p.items || p.items.length === 0) return panelWrap('Specs', `<div class="empty">no .spec.md under ${escapeHtml(p?.dir || '')}</div>`);
  const rows = p.items.map((s) => `<tr><td><span class="pill pill-${escapeHtml(s.state)}">${escapeHtml(s.state)}</span></td><td>${escapeHtml(s.path)}</td><td class="muted">${s.lines}</td><td class="muted">${escapeHtml(s.mtime.slice(0, 16).replace('T', ' '))}</td></tr>`).join('');
  return panelWrap('Specs (' + p.items.length + ')', `<table class="compact"><thead><tr><th>state</th><th>path</th><th>lines</th><th>edited</th></tr></thead><tbody>${rows}</tbody></table>`);
}
{{ENDIF}}
{{IF PANEL_COMMITS}}

function renderCommitsPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Commits', err);
  if (!p || !p.items) return panelWrap('Commits', '<div class="empty">no data</div>');
  const spark = p.sparkline ? sparklineSvg(p.sparkline.map((s) => s.y)) : '';
  const rows = p.items.map((c) => `<tr><td class="muted">${escapeHtml(c.hash)}</td><td>${escapeHtml(c.subject)}</td><td class="muted">${escapeHtml(c.author || '')}</td><td class="muted">${escapeHtml(c.when || '')}</td></tr>`).join('');
  return panelWrap('Commits', `
    <div class="muted" style="margin-bottom:.3rem">last 14d &nbsp; ${spark}</div>
    <table class="compact"><thead><tr><th>hash</th><th>subject</th><th>author</th><th>when</th></tr></thead><tbody>${rows}</tbody></table>
  `);
}
{{ENDIF}}
{{IF PANEL_SUBAGENTS}}

function renderSubagentsPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Subagents', err);
  const cls = p.active > 0 ? 'ok' : 'muted';
  const list = (p.recent || []).map((r) => `<div class="muted" style="font-family:var(--mono);font-size:.78rem">${escapeHtml(r.file)} <span style="color:var(--muted)">${escapeHtml(r.mtime.slice(11,19))}</span></div>`).join('') || '<div class="empty">none in last 60s</div>';
  return panelWrap('Subagents', `<div class="stat-big ${cls}">${p.active}</div><div class="muted" style="font-size:.7rem;margin-bottom:.4rem">active in last 60s</div>${list}`);
}
{{ENDIF}}
{{IF PANEL_GIT}}

function renderGitPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Git', err);
  const dirtyCls = p.dirty_count === 0 ? 'ok' : 'warn';
  const sync = p.has_upstream ? `${p.ahead}↑ ${p.behind}↓` : 'no upstream';
  const dirtyList = (p.dirty_files || []).slice(0, 8).map((f) => `<div class="muted" style="font-family:var(--mono);font-size:.78rem">${escapeHtml(f)}</div>`).join('');
  return panelWrap('Git', `
    <div class="kv">
      <div class="k">branch</div><div class="v">${escapeHtml(p.branch || '?')}</div>
      <div class="k">dirty</div><div class="v ${dirtyCls}">${p.dirty_count} files</div>
      <div class="k">vs upstream</div><div class="v">${escapeHtml(sync)}</div>
    </div>
    ${dirtyList ? '<div style="margin-top:.4rem">' + dirtyList + '</div>' : ''}
  `);
}
{{ENDIF}}
{{IF PANEL_TASKS}}

function renderTasksPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Tasks', err);
  if (p.source === 'tasks.md') {
    return panelWrap('Tasks (tasks.md)', `
      <div class="stat-grid">
        <div class="stat-cell"><div class="label">total</div><div class="stat-big">${p.total}</div></div>
        <div class="stat-cell"><div class="label">open</div><div class="stat-big warn">${p.open}</div></div>
        <div class="stat-cell"><div class="label">in-prog</div><div class="stat-big ok">${p.in_progress}</div></div>
        <div class="stat-cell"><div class="label">done</div><div class="stat-big muted">${p.done}</div></div>
      </div>
      <div class="muted" style="font-size:.7rem;margin-top:.4rem">${escapeHtml(p.file)}</div>
    `);
  }
  if (p.source === 'github') {
    const items = (p.items || []).map((i) => `<tr><td class="muted">#${i.number}</td><td>${escapeHtml(i.title)}</td></tr>`).join('');
    return panelWrap('Tasks (GitHub)', `
      <div class="stat-big warn">${p.open}</div><div class="muted" style="font-size:.7rem">open issues${p.label_filter ? ' (label: ' + escapeHtml(p.label_filter) + ')' : ''}</div>
      ${items ? '<table class="compact" style="margin-top:.5rem"><tbody>' + items + '</tbody></table>' : ''}
    `);
  }
  return panelWrap('Tasks', '<div class="empty">unknown source</div>');
}
{{ENDIF}}
{{IF PANEL_COMMAND}}

function renderCommandPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('{{COMMAND_LABEL}}', err);
  const cls = p.ok ? 'ok' : 'bad';
  return panelWrap('{{COMMAND_LABEL}}', `
    <div class="kv">
      <div class="k">cmd</div><div class="v" style="font-family:var(--mono);font-size:.78rem">${escapeHtml(p.cmd)}</div>
      <div class="k">exit</div><div class="v ${cls}">${p.exit_code}</div>
      ${p.status ? '<div class="k">status</div><div class="v">' + escapeHtml(p.status) + '</div>' : ''}
      <div class="k">when</div><div class="v muted">${escapeHtml(p.finished_at || '')}</div>
    </div>
    <pre class="tail">${escapeHtml(p.output_tail || '')}</pre>
  `);
}
{{ENDIF}}
{{IF PANEL_PROCESSES}}

function renderProcessesPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Processes', err);
  const items = (p.processes || []).map((x) => `<tr><td class="muted">${x.pid}</td><td>${escapeHtml(x.pattern)}</td><td class="muted">${escapeHtml(x.etime)}</td><td>${escapeHtml(x.args)}</td></tr>`).join('');
  if (!items) return panelWrap('Processes', `<div class="empty">no processes match: ${escapeHtml(p.patterns.join(', '))}</div>`);
  return panelWrap('Processes', `<table class="compact"><thead><tr><th>pid</th><th>pattern</th><th>uptime</th><th>args</th></tr></thead><tbody>${items}</tbody></table>`);
}
{{ENDIF}}
{{IF PANEL_BENCH}}

function renderBenchPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Bench', err);
  if (!p.runs || p.runs.length === 0) return panelWrap('Bench', `<div class="empty">${escapeHtml(p.note || 'no runs')}</div>`);
  const rows = p.runs.map((r) => {
    const pct = r.hidden_pass_total > 0 ? ((r.hidden_pass_sum / r.hidden_pass_total) * 100).toFixed(0) + '%' : '—';
    return `<tr><td>${escapeHtml(r.run_id)}</td><td class="muted">${r.trials}</td><td>${r.hidden_pass_sum}/${r.hidden_pass_total}</td><td class="ok">${pct}</td><td class="muted">${escapeHtml(r.mtime.slice(0, 16).replace('T', ' '))}</td></tr>`;
  }).join('');
  return panelWrap('Bench', `<table class="compact"><thead><tr><th>run</th><th>trials</th><th>hidden_pass</th><th>%</th><th>updated</th></tr></thead><tbody>${rows}</tbody></table>`);
}
{{ENDIF}}
{{IF PANEL_TIMESERIES}}

function renderTimeseriesPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Timeseries', err);
  const last = p.last ? `${escapeHtml(p.x_label)}=${escapeHtml(String(p.last.x))} ${escapeHtml(p.y_label)}=${escapeHtml(String(p.last.y))}` : '—';
  return panelWrap(`Timeseries — ${p.y_label} over ${p.x_label}`, `
    <div class="muted" style="font-size:.78rem;margin-bottom:.3rem">${escapeHtml(p.source)} · n=${p.points.length} · last: ${last}</div>
    ${lineChartSvg(p.points)}
  `, true);
}
{{ENDIF}}
{{IF PANEL_BAR}}

function renderBarPanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Bar chart', err);
  return panelWrap(`${p.y_label} by ${p.x_label}`, `
    <div class="muted" style="font-size:.78rem;margin-bottom:.3rem">${escapeHtml(p.source)} · ${p.bars.length} bars</div>
    ${barChartSvg(p.bars)}
  `, true);
}
{{ENDIF}}
{{IF PANEL_SPARKLINE}}

function renderSparklinePanel(p) {
  const err = errorBody(p); if (err) return panelWrap('Sparkline', err);
  const last = p.last != null ? p.last : '—';
  return panelWrap(p.label || 'Sparkline', `
    <div class="stat-big">${escapeHtml(String(last))}</div>
    <div class="muted" style="font-size:.7rem">${escapeHtml(p.y_label)} · n=${p.points.length}</div>
    <div style="margin-top:.4rem">${sparklineSvg(p.points, { w: 280, h: 50 })}</div>
  `);
}
{{ENDIF}}

function render(snapshot) {
  if (!snapshot || !snapshot.panels) {
    document.getElementById('grid').innerHTML = '<div class="empty">no snapshot</div>';
    return;
  }
  const out = [];
  const P = snapshot.panels;
  {{IF PANEL_TESTS}}out.push(renderTestsPanel(P.tests));{{ENDIF}}
  {{IF PANEL_GIT}}out.push(renderGitPanel(P.git));{{ENDIF}}
  {{IF PANEL_TASKS}}out.push(renderTasksPanel(P.tasks));{{ENDIF}}
  {{IF PANEL_SUBAGENTS}}out.push(renderSubagentsPanel(P.subagents));{{ENDIF}}
  {{IF PANEL_SPARKLINE}}out.push(renderSparklinePanel(P.sparkline));{{ENDIF}}
  {{IF PANEL_PROCESSES}}out.push(renderProcessesPanel(P.processes));{{ENDIF}}
  {{IF PANEL_COMMAND}}out.push(renderCommandPanel(P.command));{{ENDIF}}
  {{IF PANEL_SPECS}}out.push(renderSpecsPanel(P.specs));{{ENDIF}}
  {{IF PANEL_COMMITS}}out.push(renderCommitsPanel(P.commits));{{ENDIF}}
  {{IF PANEL_BENCH}}out.push(renderBenchPanel(P.bench));{{ENDIF}}
  {{IF PANEL_TIMESERIES}}out.push(renderTimeseriesPanel(P.timeseries));{{ENDIF}}
  {{IF PANEL_BAR}}out.push(renderBarPanel(P.bar));{{ENDIF}}
  document.getElementById('grid').innerHTML = out.filter(Boolean).join('');
  document.getElementById('generated-at').textContent = 'generated ' + (snapshot.generated_at || '?');
}

async function tick() {
  try {
    const r = await fetch('data.json', { cache: 'no-store' });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const snap = await r.json();
    render(snap);
    lastFetchOk = Date.now();
    document.getElementById('live-dot').className = 'live-dot';
  } catch (err) {
    document.getElementById('generated-at').textContent = 'fetch failed: ' + err.message;
    document.getElementById('live-dot').className = 'live-dot dead';
  }
  setTimeout(() => {
    if (lastFetchOk && Date.now() - lastFetchOk > STALE_AFTER_MS) {
      document.getElementById('live-dot').className = 'live-dot stale';
    }
  }, STALE_AFTER_MS + 500);
}

document.getElementById('refresh-now').addEventListener('click', tick);
tick();
timer = setInterval(tick, REFRESH_MS);
</script>
</body>
</html>
