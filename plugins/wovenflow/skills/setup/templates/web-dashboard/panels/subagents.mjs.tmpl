// Reference probe: subagents panel.
//
// Counts subagent transcript .jsonl files under
// ~/.claude/projects/<slug>/ that have been modified in the last 60s.
// Slug is the absolute repo path with slashes replaced by dashes (and a
// leading dash). No external dependencies — pure filesystem.
//
// Returns: { active: number, recent: [{file, mtime}], project_dir }

import { readdirSync, statSync, existsSync } from 'node:fs';
import { join, relative } from 'node:path';

export function probeSubagents(repoRoot) {
  if (!process.env.HOME) return { error: 'no $HOME' };
  const slug = '-' + repoRoot.replace(/^\//, '').replace(/\//g, '-');
  const root = join(process.env.HOME, '.claude/projects', slug);
  if (!existsSync(root)) return { active: 0, recent: [], project_dir: root, note: 'no project dir' };
  const cutoff = Date.now() - 60_000;
  let active = 0;
  const recent = [];
  const stack = [root];
  while (stack.length) {
    const cur = stack.pop();
    let names; try { names = readdirSync(cur); } catch { continue; }
    for (const name of names) {
      const full = join(cur, name);
      let st; try { st = statSync(full); } catch { continue; }
      if (st.isDirectory()) stack.push(full);
      else if (name.endsWith('.jsonl') && st.mtimeMs > cutoff) {
        active++;
        recent.push({ file: relative(root, full), mtime: st.mtime.toISOString() });
      }
    }
  }
  recent.sort((a, b) => b.mtime.localeCompare(a.mtime));
  return { active, recent: recent.slice(0, 10), project_dir: root };
}
