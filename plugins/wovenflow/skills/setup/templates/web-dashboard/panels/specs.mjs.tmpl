// Reference probe: specs panel.
//
// Lists *.spec.md under {{SPECS_DIR}} and infers a state per spec:
// - "designed" — only the spec exists
// - "tested"   — a sibling .test.* file exists with matching basename
// - (no "built" yet — too noisy to infer cross-language)
//
// Returns: { dir, items: [{ path, mtime, size, lines, state }] }

import { readdirSync, readFileSync, statSync, existsSync } from 'node:fs';
import { join, relative } from 'node:path';

const DIR = '{{SPECS_DIR}}';

function listFiles(root, predicate, max = 500) {
  const out = []; if (!existsSync(root)) return out;
  const stack = [root];
  while (stack.length && out.length < max) {
    const cur = stack.pop();
    let names; try { names = readdirSync(cur); } catch { continue; }
    for (const name of names) {
      if (name === 'node_modules' || name === '.git') continue;
      const full = join(cur, name);
      let st; try { st = statSync(full); } catch { continue; }
      if (st.isDirectory()) stack.push(full);
      else if (st.isFile() && predicate(full)) out.push({ full, mtime: st.mtime, size: st.size });
    }
  }
  return out;
}

export function probeSpecs(repoRoot) {
  const root = join(repoRoot, DIR);
  const files = listFiles(root, (f) => f.endsWith('.spec.md'), 200);
  const items = files.map(({ full, mtime, size }) => {
    const rel = relative(repoRoot, full);
    const lines = readFileSync(full, 'utf8').split('\n').length;
    const base = rel.split('/').pop().replace(/\.spec\.md$/, '');
    const tests = listFiles(repoRoot, (f) => {
      const n = f.split('/').pop();
      return n.includes(base) && /\.(test|spec)\.(js|ts|mjs|py|rs|go)$/.test(n);
    }, 50);
    return {
      path: rel, mtime: mtime.toISOString(), size, lines,
      state: tests.length > 0 ? 'tested' : 'designed',
    };
  });
  items.sort((a, b) => b.mtime.localeCompare(a.mtime));
  return { dir: DIR, items };
}
