#!/usr/bin/env node
// Project dashboard — periodic data writer.
//
// Generated by `wovenflow:setup` from
//   plugins/wovenflow/skills/setup/templates/web-dashboard/serve.mjs.tmpl
// for project: {{PROJECT_NAME}}
// Panels enabled: {{PANELS_LIST}}
//
// What this does:
//   Every {{INTERVAL_S}}s, it polls the panels you enabled (tests, specs,
//   git status, etc.), bundles the result into one `data.json`, and writes
//   it next to `index.html`. The HTML SPA polls `data.json` and re-renders.
//
// Usage:
//   node web/serve.mjs                     # serve + write loop (default {{INTERVAL_S}}s)
//   node web/serve.mjs <seconds>           # custom interval
//   node web/serve.mjs --once              # write data.json once and exit
//   node web/serve.mjs --serve             # also start a tiny HTTP server on port {{PORT}}
//
// REPO_ROOT is process.cwd() — run this from your project root.
// WEB_DIR is __dirname (resolves through symlinks; that's intentional for
// the umbrella pattern where `<repo>/web` is a symlink into a shared web
// root and we want data.json next to the served index.html).
{{IF UMBRELLA_PATH}}
//
// Umbrella mode: this file expects `<repo>/web/` to be (or symlink into)
// `{{UMBRELLA_PATH}}/{{PROJECT_NAME}}/`. The umbrella's HTTP server (e.g.
// `python3 -m http.server` from {{UMBRELLA_PATH}}) serves both
// `/{{PROJECT_NAME}}/index.html` and `/{{PROJECT_NAME}}/data.json`.
{{ENDIF}}

import {
  readFileSync,
  readdirSync,
  statSync,
  existsSync,
  writeFileSync,
} from 'node:fs';
import { join, dirname, relative } from 'node:path';
import { fileURLToPath } from 'node:url';
import { spawnSync } from 'node:child_process';
import { createServer } from 'node:http';

const REPO_ROOT = process.cwd();
const WEB_DIR = dirname(fileURLToPath(import.meta.url));
const DATA_OUT = join(WEB_DIR, 'data.json');

const args = process.argv.slice(2);
const ONCE = args.includes('--once');
const SERVE = args.includes('--serve');
const INTERVAL_S = (() => {
  for (const a of args) {
    if (a.startsWith('--')) continue;
    const n = Number(a);
    if (Number.isFinite(n) && n > 0) return n;
  }
  return {{INTERVAL_S}};
})();
const PORT = {{PORT}};

// ---------- shared helpers ----------

function tryShell(cmd, argv, opts = {}) {
  const { cwd = REPO_ROOT, timeoutMs = 5000 } = opts;
  try {
    const r = spawnSync(cmd, argv, { cwd, timeout: timeoutMs, encoding: 'utf8' });
    return { ok: r.status === 0, stdout: r.stdout || '', stderr: r.stderr || '', code: r.status };
  } catch (err) {
    return { ok: false, stdout: '', stderr: String(err.message || err), code: -1 };
  }
}

function readJsonOrNull(path) {
  try { return JSON.parse(readFileSync(path, 'utf8')); } catch { return null; }
}

function fileMtime(path) {
  try { return statSync(path).mtime.toISOString(); } catch { return null; }
}

function listFilesRecursive(root, predicate, max = 500) {
  const out = [];
  if (!existsSync(root)) return out;
  const stack = [root];
  while (stack.length && out.length < max) {
    const cur = stack.pop();
    let names;
    try { names = readdirSync(cur); } catch { continue; }
    for (const name of names) {
      if (name === 'node_modules' || name === '.git' || name.startsWith('.venv')) continue;
      const full = join(cur, name);
      let st;
      try { st = statSync(full); } catch { continue; }
      if (st.isDirectory()) stack.push(full);
      else if (st.isFile() && predicate(full, st)) out.push({ full, mtime: st.mtime, size: st.size });
    }
  }
  return out;
}

// ---------- panels ----------
{{IF PANEL_TESTS}}

// PANEL: tests — runs `{{TESTS_CMD}}` and parses pass/fail.
// Cached so we don't re-run on every tick. Re-runs every {{TESTS_INTERVAL_S}}s.
let _testsCache = { at: 0, value: null };
function probeTests() {
  const now = Date.now();
  if (_testsCache.value && now - _testsCache.at < {{TESTS_INTERVAL_S}} * 1000) {
    return _testsCache.value;
  }
  const startedAt = new Date().toISOString();
  const r = tryShell('sh', ['-c', `{{TESTS_CMD}}`], { timeoutMs: 120000 });
  const out = (r.stdout + '\n' + r.stderr);
  // Parse heuristics: node:test "# pass N", jest "Tests: N passed",
  // pytest "N passed", cargo "test result: ok. N passed".
  let pass = null, fail = null, total = null;
  let m;
  if ((m = out.match(/#\s*pass\s+(\d+)/i))) pass = +m[1];
  if ((m = out.match(/#\s*fail\s+(\d+)/i))) fail = +m[1];
  if ((m = out.match(/Tests:\s+(\d+)\s+failed[^\n]*?(\d+)\s+passed/i))) { fail = +m[1]; pass = +m[2]; }
  if ((m = out.match(/(\d+)\s+passed[^\n]*?(\d+)\s+failed/i))) { pass = +m[1]; fail = +m[2]; }
  if ((m = out.match(/(\d+)\s+passed/i)) && pass == null) pass = +m[1];
  if ((m = out.match(/(\d+)\s+failed/i)) && fail == null) fail = +m[1];
  if ((m = out.match(/test result:\s+(ok|FAILED)\.\s+(\d+)\s+passed[^;]*?;\s*(\d+)\s+failed/i))) { pass = +m[2]; fail = +m[3]; }
  if (pass != null && fail != null) total = pass + fail;
  const value = {
    cmd: `{{TESTS_CMD}}`,
    started_at: startedAt,
    finished_at: new Date().toISOString(),
    exit_code: r.code,
    ok: r.ok,
    pass, fail, total,
    output_tail: out.split('\n').slice(-20).join('\n').slice(0, 2000),
  };
  _testsCache = { at: now, value };
  return value;
}
{{ENDIF}}
{{IF PANEL_SPECS}}

// PANEL: specs — list `*.spec.md` files under {{SPECS_DIR}} and infer state
// from filesystem signals (has tests yet? has implementation yet?).
function probeSpecs() {
  const root = join(REPO_ROOT, '{{SPECS_DIR}}');
  const files = listFilesRecursive(root, (f) => f.endsWith('.spec.md'), 200);
  const items = files.map(({ full, mtime, size }) => {
    const rel = relative(REPO_ROOT, full);
    let lines = 0;
    try { lines = readFileSync(full, 'utf8').split('\n').length; } catch {}
    // Heuristics: "tested" if a sibling .test.* exists with matching base.
    // "designed" otherwise. "built" is hard to detect generically; we mark
    // built when there's a .test.* AND a non-test source file matching the
    // spec's basename anywhere under REPO_ROOT.
    const base = rel.split('/').pop().replace(/\.spec\.md$/, '');
    let state = 'designed';
    const testFiles = listFilesRecursive(REPO_ROOT, (f) => {
      const n = f.split('/').pop();
      return n.includes(base) && /\.(test|spec)\.(js|ts|mjs|py|rs|go)$/.test(n);
    }, 50);
    if (testFiles.length > 0) state = 'tested';
    return { path: rel, mtime: mtime.toISOString(), size, lines, state };
  });
  items.sort((a, b) => b.mtime.localeCompare(a.mtime));
  return { dir: '{{SPECS_DIR}}', items };
}
{{ENDIF}}
{{IF PANEL_COMMITS}}

// PANEL: commits — last {{COMMITS_LIMIT}} commits.
function probeCommits() {
  const args = ['log', '-{{COMMITS_LIMIT}}', '--pretty=format:%H%x09%an%x09%ar%x09%s'];
  {{IF COMMITS_BRANCH}}args.push('{{COMMITS_BRANCH}}');{{ENDIF}}
  const r = tryShell('git', args);
  if (!r.ok) return { error: r.stderr.trim() || 'git log failed' };
  const items = r.stdout.split('\n').filter(Boolean).map((line) => {
    const [hash, author, when, ...rest] = line.split('\t');
    return { hash: (hash || '').slice(0, 8), author, when, subject: rest.join('\t') };
  });
  // Sparkline-ready: commits per day for last 14 days.
  const dailyR = tryShell('git', ['log', '--since=14.days.ago', '--pretty=format:%cs']);
  const counts = {};
  for (const day of dailyR.stdout.split('\n').filter(Boolean)) counts[day] = (counts[day] || 0) + 1;
  const today = new Date();
  const series = [];
  for (let i = 13; i >= 0; i--) {
    const d = new Date(today);
    d.setDate(today.getDate() - i);
    const k = d.toISOString().slice(0, 10);
    series.push({ x: k, y: counts[k] || 0 });
  }
  return { items, sparkline: series };
}
{{ENDIF}}
{{IF PANEL_SUBAGENTS}}

// PANEL: subagents — count subagent transcript files modified in last 60s.
// Looks under ~/.claude/projects/<slug>/ where slug is the cwd with
// slashes replaced by dashes.
function probeSubagents() {
  if (!process.env.HOME) return { error: 'no $HOME' };
  const slug = '-' + REPO_ROOT.replace(/^\//, '').replace(/\//g, '-');
  const root = join(process.env.HOME, '.claude/projects', slug);
  if (!existsSync(root)) return { active: 0, recent: [], project_dir: root, note: 'no project dir' };
  const cutoff = Date.now() - 60_000;
  let active = 0;
  const recent = [];
  const files = listFilesRecursive(root, (f, st) => f.endsWith('.jsonl'), 200);
  for (const { full, mtime } of files) {
    if (mtime.getTime() > cutoff) {
      active++;
      recent.push({ file: relative(root, full), mtime: mtime.toISOString() });
    }
  }
  recent.sort((a, b) => b.mtime.localeCompare(a.mtime));
  return { active, recent: recent.slice(0, 10), project_dir: root };
}
{{ENDIF}}
{{IF PANEL_GIT}}

// PANEL: git — branch, dirty files, ahead/behind upstream.
function probeGit() {
  const branchR = tryShell('git', ['branch', '--show-current']);
  const branch = branchR.ok ? branchR.stdout.trim() : null;
  const statusR = tryShell('git', ['status', '--porcelain=v1']);
  const dirty = statusR.ok ? statusR.stdout.split('\n').filter(Boolean) : [];
  const upstreamR = tryShell('git', ['rev-list', '--left-right', '--count', '@{u}...HEAD']);
  let ahead = null, behind = null;
  if (upstreamR.ok) {
    const m = upstreamR.stdout.trim().split(/\s+/);
    if (m.length === 2) { behind = +m[0]; ahead = +m[1]; }
  }
  return {
    branch,
    dirty_count: dirty.length,
    dirty_files: dirty.slice(0, 20),
    ahead, behind,
    has_upstream: ahead != null,
  };
}
{{ENDIF}}
{{IF PANEL_TASKS}}

// PANEL: tasks — auto-detects tasks.md OR GitHub Issues.
function probeTasks() {
  const tasksFile = join(REPO_ROOT, '{{TASKS_FILE}}');
  if (existsSync(tasksFile)) {
    const txt = readFileSync(tasksFile, 'utf8');
    // Count by status column heuristically.
    const lines = txt.split('\n').filter((l) => l.startsWith('|') && !l.startsWith('|---'));
    let open = 0, in_progress = 0, done = 0, total = 0;
    for (const line of lines) {
      if (line.toLowerCase().includes('| status') || line.toLowerCase().includes('|---')) continue;
      const cells = line.split('|').map((c) => c.trim().toLowerCase());
      const status = cells.find((c) => /^(ready|in.progress|in.review|done|blocked|todo|open)$/.test(c));
      if (!status) continue;
      total++;
      if (/done|closed/.test(status)) done++;
      else if (/in.progress|in.review/.test(status)) in_progress++;
      else open++;
    }
    return { source: 'tasks.md', file: '{{TASKS_FILE}}', total, open, in_progress, done };
  }
  // Fall back to gh.
  const labels = `{{TASKS_LABELS}}`.trim();
  const args = ['issue', 'list', '--state', 'open', '--json', 'number,title,labels'];
  if (labels) { args.push('--label'); args.push(labels); }
  const r = tryShell('gh', args, { timeoutMs: 6000 });
  if (!r.ok) return { source: 'unknown', error: 'no tasks.md and gh failed/missing' };
  let issues = [];
  try { issues = JSON.parse(r.stdout); } catch {}
  return {
    source: 'github',
    open: issues.length,
    items: issues.slice(0, 10).map((i) => ({ number: i.number, title: i.title })),
    label_filter: labels || null,
  };
}
{{ENDIF}}
{{IF PANEL_COMMAND}}

// PANEL: command — runs a user-supplied shell command and surfaces stdout.
let _cmdCache = { at: 0, value: null };
function probeCommand() {
  const now = Date.now();
  if (_cmdCache.value && now - _cmdCache.at < {{COMMAND_INTERVAL_S}} * 1000) {
    return _cmdCache.value;
  }
  const r = tryShell('sh', ['-c', `{{COMMAND_CMD}}`], { timeoutMs: 30000 });
  let status = null;
  {{IF COMMAND_REGEX}}
  const m = (r.stdout + '\n' + r.stderr).match(/{{COMMAND_REGEX}}/);
  if (m) status = m[1] ?? m[0];
  {{ENDIF}}
  const value = {
    cmd: `{{COMMAND_CMD}}`,
    label: `{{COMMAND_LABEL}}`,
    exit_code: r.code,
    ok: r.ok,
    status,
    output_tail: (r.stdout + (r.stderr ? '\n--- stderr ---\n' + r.stderr : '')).split('\n').slice(-15).join('\n').slice(0, 2000),
    finished_at: new Date().toISOString(),
  };
  _cmdCache = { at: now, value };
  return value;
}
{{ENDIF}}
{{IF PANEL_PROCESSES}}

// PANEL: processes — match running processes by name pattern.
function probeProcesses() {
  const r = tryShell('ps', ['-eo', 'pid,etime,comm,args']);
  if (!r.ok) return { error: 'ps failed' };
  const patterns = `{{PROCESSES_PATTERNS}}`.split(',').map((s) => s.trim()).filter(Boolean);
  if (patterns.length === 0) return { processes: [], patterns };
  const isClaude = (line) => /\bclaude\b|claude-snapshot|claude-shell-snapshot/.test(line);
  const matches = [];
  for (const line of r.stdout.split('\n').slice(1)) {
    if (isClaude(line)) continue;
    const matched = patterns.find((p) => line.includes(p));
    if (!matched) continue;
    const m = line.trim().match(/^(\d+)\s+(\S+)\s+(\S+)\s+(.*)$/);
    if (m) matches.push({
      pid: +m[1],
      etime: m[2],
      comm: m[3],
      args: m[4].slice(0, 240),
      pattern: matched,
    });
  }
  return { processes: matches, patterns };
}
{{ENDIF}}
{{IF PANEL_BENCH}}

// PANEL: bench — wovenflow bench results (advanced; auto-detects).
function probeBench() {
  const root = join(REPO_ROOT, 'bench', 'results');
  if (!existsSync(root)) return { runs: [], note: 'no bench/results' };
  const runs = [];
  for (const name of readdirSync(root)) {
    const full = join(root, name);
    let st; try { st = statSync(full); } catch { continue; }
    if (!st.isDirectory()) continue;
    let trials = 0, hidden_pass_total = 0, hidden_pass_sum = 0;
    try {
      for (const tname of readdirSync(full)) {
        const tpath = join(full, tname);
        if (!statSync(tpath).isDirectory()) continue;
        trials++;
        const meta = readJsonOrNull(join(tpath, 'meta.json'));
        if (meta?.hidden_pass) {
          hidden_pass_sum += meta.hidden_pass.pass_count || 0;
          hidden_pass_total += meta.hidden_pass.total_count || 0;
        }
      }
    } catch {}
    runs.push({ run_id: name, mtime: st.mtime.toISOString(), trials, hidden_pass_sum, hidden_pass_total });
  }
  runs.sort((a, b) => b.mtime.localeCompare(a.mtime));
  return { runs: runs.slice(0, 8) };
}
{{ENDIF}}
{{IF PANEL_TIMESERIES}}

// PANEL: timeseries — load points from a JSONL or CSV file.
// Source: {{TIMESERIES_SOURCE}}, x: {{TIMESERIES_X}}, y: {{TIMESERIES_Y}}.
function probeTimeseries() {
  const src = join(REPO_ROOT, '{{TIMESERIES_SOURCE}}');
  if (!existsSync(src)) return { error: 'source not found: {{TIMESERIES_SOURCE}}' };
  let txt = '';
  try { txt = readFileSync(src, 'utf8'); } catch (e) { return { error: e.message }; }
  const xKey = '{{TIMESERIES_X}}';
  const yKey = '{{TIMESERIES_Y}}';
  const points = [];
  if (src.endsWith('.csv')) {
    const lines = txt.split('\n').filter(Boolean);
    if (lines.length < 2) return { points: [], note: 'no data rows' };
    const headers = lines[0].split(',').map((h) => h.trim());
    const ix = headers.indexOf(xKey);
    const iy = headers.indexOf(yKey);
    if (ix < 0 || iy < 0) return { error: `columns ${xKey}/${yKey} missing; got ${headers.join(',')}` };
    for (const line of lines.slice(1)) {
      const cols = line.split(',');
      const x = cols[ix]?.trim();
      const y = Number(cols[iy]);
      if (x != null && Number.isFinite(y)) points.push({ x, y });
    }
  } else {
    for (const line of txt.split('\n')) {
      if (!line.trim()) continue;
      let obj; try { obj = JSON.parse(line); } catch { continue; }
      const x = obj[xKey];
      const y = Number(obj[yKey]);
      if (x != null && Number.isFinite(y)) points.push({ x, y });
    }
  }
  return {
    source: '{{TIMESERIES_SOURCE}}',
    x_label: xKey,
    y_label: yKey,
    points: points.slice(-200),
    last: points[points.length - 1] || null,
  };
}
{{ENDIF}}
{{IF PANEL_BAR}}

// PANEL: bar — load comparison data from a JSON file: an array of
// {x, y} or an object {label: value}. Source: {{BAR_SOURCE}}.
function probeBar() {
  const src = join(REPO_ROOT, '{{BAR_SOURCE}}');
  if (!existsSync(src)) return { error: 'source not found: {{BAR_SOURCE}}' };
  const data = readJsonOrNull(src);
  if (!data) return { error: 'failed to parse JSON' };
  let bars = [];
  if (Array.isArray(data)) {
    bars = data
      .map((d) => ({ x: String(d.x ?? d.label ?? ''), y: Number(d.y ?? d.value) }))
      .filter((d) => d.x && Number.isFinite(d.y));
  } else if (typeof data === 'object') {
    bars = Object.entries(data).map(([x, y]) => ({ x, y: Number(y) })).filter((d) => Number.isFinite(d.y));
  }
  return { source: '{{BAR_SOURCE}}', x_label: '{{BAR_X_LABEL}}', y_label: '{{BAR_Y_LABEL}}', bars };
}
{{ENDIF}}
{{IF PANEL_SPARKLINE}}

// PANEL: sparkline — small inline trend line.
// Source: {{SPARKLINE_SOURCE}}, y key: {{SPARKLINE_Y}}.
function probeSparkline() {
  const src = join(REPO_ROOT, '{{SPARKLINE_SOURCE}}');
  if (!existsSync(src)) return { error: 'source not found: {{SPARKLINE_SOURCE}}' };
  let txt = ''; try { txt = readFileSync(src, 'utf8'); } catch { return { error: 'read failed' }; }
  const yKey = '{{SPARKLINE_Y}}';
  const points = [];
  for (const line of txt.split('\n')) {
    if (!line.trim()) continue;
    let obj; try { obj = JSON.parse(line); } catch { continue; }
    const y = Number(obj[yKey]);
    if (Number.isFinite(y)) points.push(y);
  }
  return {
    source: '{{SPARKLINE_SOURCE}}',
    label: '{{SPARKLINE_LABEL}}',
    y_label: yKey,
    points: points.slice(-50),
    last: points[points.length - 1] ?? null,
  };
}
{{ENDIF}}

// ---------- snapshot ----------

function buildSnapshot() {
  const snap = {
    project: '{{PROJECT_NAME}}',
    generated_at: new Date().toISOString(),
    repo_root: REPO_ROOT,
    panels: {},
  };
  {{IF PANEL_TESTS}}try { snap.panels.tests = probeTests(); } catch (e) { snap.panels.tests = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_SPECS}}try { snap.panels.specs = probeSpecs(); } catch (e) { snap.panels.specs = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_COMMITS}}try { snap.panels.commits = probeCommits(); } catch (e) { snap.panels.commits = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_SUBAGENTS}}try { snap.panels.subagents = probeSubagents(); } catch (e) { snap.panels.subagents = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_GIT}}try { snap.panels.git = probeGit(); } catch (e) { snap.panels.git = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_TASKS}}try { snap.panels.tasks = probeTasks(); } catch (e) { snap.panels.tasks = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_COMMAND}}try { snap.panels.command = probeCommand(); } catch (e) { snap.panels.command = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_PROCESSES}}try { snap.panels.processes = probeProcesses(); } catch (e) { snap.panels.processes = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_BENCH}}try { snap.panels.bench = probeBench(); } catch (e) { snap.panels.bench = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_TIMESERIES}}try { snap.panels.timeseries = probeTimeseries(); } catch (e) { snap.panels.timeseries = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_BAR}}try { snap.panels.bar = probeBar(); } catch (e) { snap.panels.bar = { error: e.message }; }{{ENDIF}}
  {{IF PANEL_SPARKLINE}}try { snap.panels.sparkline = probeSparkline(); } catch (e) { snap.panels.sparkline = { error: e.message }; }{{ENDIF}}
  return snap;
}

function writeSnapshot() {
  const snap = buildSnapshot();
  writeFileSync(DATA_OUT, JSON.stringify(snap, null, 2));
  return snap;
}

// ---------- HTTP server (standalone mode) ----------

function startServer() {
  const server = createServer((req, res) => {
    const u = req.url.split('?')[0];
    const file = u === '/' || u === '' ? 'index.html' : u.replace(/^\//, '');
    if (!/^[a-zA-Z0-9._/-]+$/.test(file)) { res.statusCode = 400; return res.end('bad path'); }
    const full = join(WEB_DIR, file);
    if (!full.startsWith(WEB_DIR) || !existsSync(full)) {
      res.statusCode = 404; return res.end('not found');
    }
    const ext = full.split('.').pop();
    const ctype = { html: 'text/html', json: 'application/json', js: 'application/javascript', css: 'text/css' }[ext] || 'text/plain';
    res.setHeader('content-type', ctype);
    res.setHeader('cache-control', 'no-store');
    res.end(readFileSync(full));
  });
  server.listen(PORT, () => {
    console.log(`Dashboard: http://localhost:${PORT}/`);
  });
  return server;
}

// ---------- main ----------

if (ONCE) {
  const snap = writeSnapshot();
  console.log(`wrote ${DATA_OUT} (panels: ${Object.keys(snap.panels).join(', ')})`);
  process.exit(0);
}

console.log(`Writing ${DATA_OUT} every ${INTERVAL_S}s.`);
{{IF UMBRELLA_PATH}}console.log(`Umbrella mode: served at <umbrella-host>/{{PROJECT_NAME}}/`);{{ENDIF}}
let writing = false;
const tick = () => {
  if (writing) return;
  writing = true;
  try { writeSnapshot(); } catch (err) { console.error('write failed:', err.message); }
  finally { writing = false; }
};
tick();
setInterval(tick, INTERVAL_S * 1000);

if (SERVE) startServer();
