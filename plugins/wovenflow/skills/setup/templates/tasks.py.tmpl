#!/usr/bin/env python3
"""Compatibility shim: `tasks.py <args>` is `records.py tasks <args>`.

The markdown-table engine moved into `{{RECORDS_HELPER}}` when that became the
one interface to all of the project's records — `{{TASKS_FILE}}` among them.
This file stays because the skills call it by name
(`{{TASKS_HELPER}} set <id> --status {{STATUS_IN_PROGRESS}}`), and a rename that
breaks every call site buys nothing.

Usage is unchanged:
    {{TASKS_HELPER}} list [--status STATUS] [--owner OWNER]
    {{TASKS_HELPER}} show <id>
    {{TASKS_HELPER}} next [--status STATUS]
    {{TASKS_HELPER}} set <id> [--status STATUS] [--owner OWNER] [--notes NOTES]

Set commands remain idempotent — re-applying the same value reports "no change"
and exits 0 without rewriting the file.
"""

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
# Normally the two helpers share a directory. If the project put them apart,
# fall back to wherever `{{RECORDS_HELPER}}` was materialized — an ImportError
# here would look like a broken task tracker rather than a misplaced file.
for _dir in (_HERE, (_HERE.parent / "{{RECORDS_HELPER}}").parent):
    if (_dir / "records.py").exists():
        sys.path.insert(0, str(_dir))
        break

from records import main  # noqa: E402

if __name__ == "__main__":
    main(["tasks", *sys.argv[1:]])
